NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Admin > Users (create, disable and reset links).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheet ↔ Inventory sync. Set only after the Apps Script Web App is deployed.
GOOGLE_INVENTORY_APPS_SCRIPT_URL=
GOOGLE_INVENTORY_SYNC_SECRET=

# Optional transactional email (server-side only)
RESEND_API_KEY=
KLGCR_EMAIL_FROM=
KLGCR_EMAIL_ENABLED=false

# Enable only after membership migration, sender, public URL and cron are verified.
KLGCR_MEMBERSHIP_ENABLED=false
# At least 32 random characters. Keep stable; encrypts private management links at rest.
KLGCR_MEMBERSHIP_TOKEN_SECRET=
# Plain text bank/payment instructions displayed on the registration page.
KLGCR_MEMBERSHIP_PAYMENT_INSTRUCTIONS=
