NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Admin > Users (create, disable and reset links).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheet ↔ Inventory sync. Set only after the Apps Script Web App is deployed.
GOOGLE_INVENTORY_APPS_SCRIPT_URL=
GOOGLE_INVENTORY_SYNC_SECRET=

# Optional transactional email (server-side only)
RESEND_API_KEY=
KLGCR_EMAIL_FROM=
KLGCR_EMAIL_ENABLED=false
